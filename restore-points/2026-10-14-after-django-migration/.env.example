HOST=127.0.0.1
PORT=3000
TLS_KEY_FILE=server.key
TLS_CERT_FILE=server.crt
COOKIE_SECURE=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,JEET-PC
